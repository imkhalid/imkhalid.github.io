<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme using Material 3 -->
    <style name="Theme.Vyntra" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.Vyntra.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.Vyntra</item>
    </style>
</resources>
